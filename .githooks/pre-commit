#!/bin/sh
#
# pre-commit versionado del repositorio.
#
# Se activa una vez por clon con:
#   git config core.hooksPath .githooks
#
# 1. gitleaks: bloquea el commit si lo preparado contiene un secreto.
#    Invariante 5 de CLAUDE.md (RN-66): nada de credenciales en el repositorio.
#    Una vez commiteado, un secreto queda en el historial aunque se borre después,
#    y hay que rotarlo; por eso se corta acá y no solo en CI.
# 2. react-doctor: el mismo chequeo que instaló react-doctor en .git/hooks,
#    movido acá para que core.hooksPath no lo deje sin efecto. Solo avisa.

# gitleaks hook start
if ! command -v gitleaks >/dev/null 2>&1; then
  printf '%s\n' \
    "gitleaks no está instalado: el commit se bloquea hasta instalarlo." \
    "  Windows: winget install Gitleaks.Gitleaks" \
    "  macOS:   brew install gitleaks" >&2
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose; then
  printf '%s\n' \
    "" \
    "gitleaks encontró un posible secreto en los cambios preparados." \
    "Sacalo del commit. Si ya se usó en algún lado, rotalo." \
    "Si es un falso positivo revisado, agregá su huella a .gitleaksignore con el motivo." >&2
  exit 1
fi
# gitleaks hook end

# react-doctor hook start
react_doctor_scan_staged_files() {
  if [ -x "./node_modules/.bin/react-doctor" ]; then
    "./node_modules/.bin/react-doctor" --staged --blocking warning
    return
  fi

  if command -v react-doctor >/dev/null 2>&1; then
    react-doctor --staged --blocking warning
    return
  fi

  if command -v pnpm >/dev/null 2>&1; then
    pnpm dlx react-doctor@latest --staged --blocking warning
    return
  fi

  if command -v npx >/dev/null 2>&1; then
    npx --yes react-doctor@latest --staged --blocking warning
    return
  fi

  printf '%s\n' "react-doctor: command not found; skipping staged scan."
}

react_doctor_output=$(mktemp "${TMPDIR:-/tmp}/react-doctor-hook.XXXXXX")
if react_doctor_scan_staged_files > "$react_doctor_output" 2>&1; then
  rm -f "$react_doctor_output"
else
  cat "$react_doctor_output" >&2
  rm -f "$react_doctor_output"
  printf '%s\n' "React Doctor found staged regressions." "Run react-doctor --staged --blocking warning to inspect." "Want them fixed? Ask your agent to run that command and resolve the findings." >&2
fi
# react-doctor hook end
