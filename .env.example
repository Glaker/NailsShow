# Copiá a .env y completá. `.env` no se versiona.
# Los valores se obtienen con:
#   supabase projects api-keys --project-ref <project-ref>

VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública (sb_publishable_... o el JWT anon legacy).
# Nunca la clave secreta: check-service-role.sh falla si aparece.
VITE_SUPABASE_ANON_KEY=
